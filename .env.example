# ========================================================================
# VARIABLES DE ENTORNO - MOTION LAB (.env.example)
# ========================================================================
# Copia este archivo a '.env.local' para tu entorno de desarrollo o pega
# estas variables en el panel de Vercel.

# 1. Base de Datos PostgreSQL (Prisma Postgres, Vercel o Local) gestionada con Prisma
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE_DATOS
DATABASE_URL="postgresql://postgres:password@localhost:5432/motion_lab"

# 2. Configuración de NextAuth (Auth.js)
# En desarrollo: http://localhost:3000 | En Vercel: https://tu-proyecto.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="motion_lab_super_secret_jwt_key_2026_matias"

# 3. Google OAuth (Opcional en local, necesario para el botón de Google en producción)
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# 4. Contacto WhatsApp del Entrenador Matías
# (Número internacional sin el signo +, ej. Argentina: 549362...)
NEXT_PUBLIC_WHATSAPP_PHONE="5493624654911"

# 5. Junction (relojes en la nube: Garmin, Polar, Fitbit, Google Health/Pixel,
#    Oura, Withings). Crear una API key Sandbox en https://app.junction.com
#    -> Team settings -> API Keys. Es una clave SOLO de servidor: no usar
#    el prefijo NEXT_PUBLIC.
#    Apple Watch (HealthKit) y Samsung Health requieren app móvil; no se
#    vinculan desde la web.
JUNCTION_API_KEY=""
JUNCTION_ENV="sandbox"
JUNCTION_REGION="us"
